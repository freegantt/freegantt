#!/usr/bin/env bash
# docs/04-hooks-and-ci.md §3: the full gate before it becomes anyone else's problem.
#
# This hook runs the gate, and it runs the whole of it. `.github/workflows/ci.yml` runs the same
# command on a pull request that asks for review (#255), so this is the faster half rather than the
# only one. It is still the only half that sees a push nobody opens a pull request for.
#
# `pnpm verify:full` runs `verify` — the browser-free chain — and then `pnpm test:e2e`. Playwright
# owns the acceptance checks happy-dom cannot express: a real engine clamps `scrollTop`, fires
# `scroll`, and lays out. Two of the five S1 acceptance boxes are e2e tests (`[S1-A1]`, `[S1-A4]`).
#
# e2e stays out of `pnpm verify` itself, on purpose: `verify` is the chain that needs no browser,
# and the wrapper adds the browser half. This hook, an agent proving its work, and CI all run that
# one wrapper (#255). One command, not three spellings of it, or the hook stops predicting what
# the others saw.
#
# `--no-verify` still works and is still not fought. CI now runs this same gate on every pull
# request that asks for review, so a skip costs a red run rather than a silent landing. A push that
# never becomes a pull request is still proved here and nowhere else.

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if [[ ! -d node_modules ]]; then
  echo "pre-push: node_modules missing — run 'pnpm install' first." >&2
  exit 1
fi

echo "pre-push: pnpm verify:full (the gate — the same command CI runs)"
pnpm verify:full

echo "pre-push: OK — every I1-I14 guard passed, and e2e is green."
