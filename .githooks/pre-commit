#!/usr/bin/env bash
# docs/04-hooks-and-ci.md §3: fast (<5s), catches the trivia. `--no-verify` exists and is not fought —
# CI is the authority.

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

staged_all="$(git diff --cached --name-only --diff-filter=ACM | while read -r f; do [[ -L "$f" ]] || echo "$f"; done)"

if [[ -n "$staged_all" ]]; then
  echo "pre-commit: format (auto-fix) on all staged files"
  pnpm exec prettier --write --ignore-unknown $staged_all
  git add -- $staged_all
fi

staged_ts="$(git diff --cached --name-only --diff-filter=ACM -- '*.ts')"

if [[ -n "$staged_ts" ]]; then
  echo "pre-commit: lint (check only — fails on any warning) on staged *.ts"
  pnpm exec eslint --max-warnings 0 --no-warn-ignored $staged_ts
fi

echo "pre-commit: vendor-names"
pnpm run --silent vendor-names
