{
  "name": "freegantt",
  "version": "0.0.1",
  "description": "Accessible, framework-free TypeScript Gantt and timeline library",
  "type": "module",
  "sideEffects": [
    "src/view/styles.ts"
  ],
  "license": "MIT",
  "author": "FreeGantt",
  "homepage": "https://github.com/freegantt/freegantt#readme",
  "bugs": {
    "url": "https://github.com/freegantt/freegantt/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freegantt/freegantt.git"
  },
  "keywords": [
    "gantt",
    "timeline",
    "typescript",
    "scheduler",
    "accessible",
    "a11y",
    "wcag",
    "aria"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/api/index.js",
  "module": "./dist/api/index.js",
  "types": "./dist/api/index.d.ts",
  "packageManager": "pnpm@11.22.0",
  "exports": {
    ".": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "node scripts/setup-hooks.mjs && node scripts/build-for-git-install.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:file": "eslint --max-warnings 0 --no-warn-ignored",
    "typecheck": "tsc --noEmit",
    "boundaries": "depcruise --config .dependency-cruiser.cjs src harness e2e fixtures",
    "test:node": "vitest run --project pure --coverage --coverage.reportsDirectory coverage/pure",
    "test:dom": "vitest run --project dom --coverage --coverage.reportsDirectory coverage/dom",
    "guards": "vitest run test/guards && node scripts/run-rule-tests.mjs && node scripts/guard-red-test.mjs",
    "sentence-length": "node scripts/check-sentence-length.mjs",
    "check-crap": "node scripts/check-crap.mjs",
    "disables": "node scripts/audit-disables.mjs",
    "gate": "node scripts/slice-gate.mjs",
    "dev": "vite",
    "docs": "node scripts/docs-site.mjs start --host 0.0.0.0",
    "docs:build": "node scripts/docs-site.mjs build",
    "build": "node scripts/build.mjs",
    "prepack": "vite build --config vite.lib.config.ts",
    "api-report": "node scripts/api-report.mjs",
    "check-doc-examples": "node scripts/check-doc-examples.mjs",
    "bundle-probe": "node scripts/bundle-probe.mjs",
    "size-limit": "size-limit",
    "check-bundle-growth": "node scripts/check-bundle-growth.mjs",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:engines": "playwright test",
    "check-pack-install": "node scripts/check-pack-install.mjs",
    "verify": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm boundaries && pnpm guards && pnpm test:node && pnpm test:dom && pnpm check-crap && pnpm sentence-length && pnpm disables && pnpm build && pnpm api-report && pnpm check-doc-examples && pnpm bundle-probe && pnpm check-bundle-growth && pnpm check-pack-install",
    "verify:full": "node scripts/verify-full.mjs",
    "open-pr": "node scripts/open-pr.mjs",
    "pr-wait": "node scripts/pr-wait.mjs",
    "ocr-review": "node scripts/ocr-review.mjs",
    "measure:scale": "node scripts/measure-scale.mjs"
  },
  "dependencies": {
    "alien-signals": "^1.0.0",
    "temporal-polyfill": "^1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.9.0",
    "@microsoft/api-extractor": "^7.59.0",
    "@playwright/test": "^1.62.1",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@types/node": "^22.5.0",
    "@typescript-eslint/parser": "^8.3.0",
    "@typescript-eslint/utils": "^8.3.0",
    "@vitest/coverage-v8": "^2.0.0",
    "dependency-cruiser": "^16.4.0",
    "eslint": "^9.9.0",
    "fast-check": "^3.21.0",
    "globals": "^15.9.0",
    "happy-dom": "^15.7.0",
    "prettier": "^3.3.3",
    "size-limit": "^13.0.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^2.0.5"
  }
}
